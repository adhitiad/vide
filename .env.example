# AI-CLIP-HUB : KONFIGURASI SISTEM (GOD-TIER EDITION)
# =======================================================
# Salin file ini menjadi ".env" dan sesuaikan isinya.

# [ DATABASE - MONGODB ]
# Digunakan untuk penyimpanan permanen video, log, dan antrean.
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=vide_db

# [ CACHE & COORDINATION - REDIS ]
# Digunakan untuk RL state, spider-network coordination, dan leaderboard.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

# [ LLM & AI MODELS ]
# 1. Groq: Untuk generate komentar provokatif & kuis retention trap.
GROQ_API_KEY=gsk_xxx...

# 2. ElevenLabs: Untuk narasi (Voice-Over) AI.
ELEVENLABS_API_KEY=sk_xxx...

# 3. Hugging Face: Untuk model sentiment analysis IndoBERT & mDeBERTa.
HF_TOKEN=hf_xxx...

# [ SOCIAL MEDIA UPLOADER - STRATEGI NON-RESMI (BROWSER/PRIVATE API) ]
# Strategi ini menghindari Meta Graph API yang rumit dan memerlukan App Review.

# Instagram: Menggunakan Private API (instagrapi).
# Sesi akan disimpan otomastis di ig_session.json.
IG_USERNAME=your_ig_username
IG_PASSWORD=your_ig_password

# Facebook & TikTok: Menggunakan Browser Automation (Playwright).
# Sesi login akan disimpan di data/fb_session dan data/tt_session.
# Anda hanya perlu login sekali secara manual saat jendela browser muncul.

# [ YOUTUBE SHORTS ]
# YouTube tetap menggunakan file "client_secrets.json" di root folder (Official API).

# [ HARDWARE OPTIMIZATION ]
USE_CUDA=true
