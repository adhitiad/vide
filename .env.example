# AI-CLIP-HUB : KONFIGURASI SISTEM (GOD-TIER EDITION)
# =======================================================
# Salin file ini menjadi ".env" dan sesuaikan isinya.

# [ DATABASE - MONGODB ]
# Digunakan untuk penyimpanan permanen video, log, dan antrean.
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=vide_db

# [ CACHE & COORDINATION - REDIS ]
# Digunakan untuk RL state, spider-network coordination, dan leaderboard.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

# [ TASK QUEUE - CELERY ]
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# [ LLM & AI MODELS ]
# 1. Groq: Untuk generate komentar provokatif & kuis retention trap.
GROQ_API_KEY=gsk_xxx...

# 2. ElevenLabs: Untuk narasi (Voice-Over) AI.
ELEVENLABS_API_KEY=sk_xxx...

# 3. Hugging Face: Untuk model sentiment analysis IndoBERT & mDeBERTa.
HF_TOKEN=hf_xxx...

# [ DISTRIBUTION NOTIFICATION - TELEGRAM ]
# Digunakan untuk notifikasi manual upload beserta link GDrive & detail caption/hashtag.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIJklmnoPQRstuvwxyz
TELEGRAM_CHAT_ID=123456789

# [ GOOGLE DRIVE ARCHIVE FOLDER IDs (Opsional, jika dibiarkan kosong akan buat otomatis) ]
# Wajib memiliki file client_secret.json di root project untuk oauth GDrive.
GDRIVE_ROOT_FOLDER_ID=

# [ HARDWARE OPTIMIZATION ]
USE_CUDA=true
