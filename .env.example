# AI-CLIP-HUB (GOD-TIER UGC EDITION) - Environment Template
# Salin file ini menjadi ".env" dan isi dengan kredensial Anda.

# --- Instagram Credentials ---
# Digunakan oleh core/uploader_ig.py untuk auto-post Reels
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password

# --- ElevenLabs AI Voice ---
# Digunakan oleh core/voice.py untuk narasi (Voice-Over)
# Dapatkan di: https://elevenlabs.io/ (Profile Settings -> API Key)
ELEVENLABS_API_KEY=

# --- Catatan Tambahan ---
# 1. Pastikan file "client_secrets.json" ada di root folder untuk YouTube API.
# 2. Redis disarankan berjalan di localhost:6379 (Tanpa password).
# 3. Disarankan menggunakan GPU NVIDIA (CUDA) untuk performa AI optimal.
